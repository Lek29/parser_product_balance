# Почта (IMAP)
EMAIL_ADDRESS=example@yandex.ru
EMAIL_PASSWORD=your_app_password_here
EMAIL_IMAP_SERVER=imap.yandex.ru
# Папка на сервере с письмами об остатках (по умолчанию INBOX; для отдельной папки — Stock)
# EMAIL_IMAP_FOLDER=Stock
# Сколько дней от сегодняшней даты учитывать по заголовку Date при обходе (по умолчанию 7).
# 0 или отрицательное значение — перебирать все письма в папке (окно отключено).
# MAIL_IMAP_MAX_MESSAGE_AGE_DAYS=7
# Очистка лишних писем в Stock (календарная неделя Пн–Вс МСК, один keeper):
#   python scripts/cleanup_stock_mail.py
#   python scripts/cleanup_stock_mail.py --execute
# Автоматически: планировщик пн 09:30 МСК (services.stock_mail_cleanup, execute=True).

# Telegram
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
BOT_PASSWORD=your_bot_password_here
# Личный chat id: алерты лимитов + xlsx «ушли в ноль» (docs/fourty_role.md, push_message_about_zero.md).
# STOCK_LIMIT_ALERT_CHAT_ID=520258341

# Порог малого остатка (позиции с количеством <= значения попадают в выгрузку)
STOCK_THRESHOLD=5
